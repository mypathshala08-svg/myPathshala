<?xml version="1.0"?>
<!-- fair-scheduler.xml: two queues with equal weight; inside a queue, apps share fairly -->
<allocations>
  <queue name="prod"><weight>1.0</weight><schedulingPolicy>fair</schedulingPolicy></queue>
  <queue name="dev"><weight>1.0</weight><schedulingPolicy>fair</schedulingPolicy></queue>
  <queueMaxAMShareDefault>0.5</queueMaxAMShareDefault>
</allocations>

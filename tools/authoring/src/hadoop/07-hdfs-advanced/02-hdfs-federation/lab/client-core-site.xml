<?xml version="1.0"?>
<!-- Client view of the federated cluster: one tree, two NameNodes behind it (ViewFS mount table). -->
<configuration>
  <property><name>fs.defaultFS</name><value>viewfs://campus</value></property>
  <property><name>fs.viewfs.mounttable.campus.link./canteen</name><value>hdfs://nn-canteen:8020/canteen</value></property>
  <property><name>fs.viewfs.mounttable.campus.link./hostel</name><value>hdfs://nn-hostel:8020/hostel</value></property>
  <property><name>fs.viewfs.mounttable.campus.link./tmp</name><value>hdfs://nn-hostel:8020/tmp</value></property>
</configuration>

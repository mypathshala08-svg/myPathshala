REVISION = [
    '<b>Distribution</b> = Linux kernel + GNU tools + package manager + repositories + installer + defaults + support cycle.',
    '<b>Debian family</b>: Debian, Ubuntu, Mint, Kali · <code>.deb</code> · <code>apt</code>/<code>dpkg</code>.',

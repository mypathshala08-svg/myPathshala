TRACE = dict(
    heading='Reading an os-release file, line by line',
    intro='<p>The script writes one sample file, loads it with <code>.</code> and decides the family. Watch the variables <code>ID</code>, <code>ID_LIKE</code> and <code>tool</code> appear in the <b>Shell</b> box.</p>',
    code='''printf 'ID=ubuntu\\nID_LIKE=debian\\nVERSION_ID=24.04\\n' > os-release
cat os-release
. ./os-release
echo "ID is $ID, family is $ID_LIKE"
if [ "$ID_LIKE" = "debian" ]; then tool=apt; else tool=dnf; fi
echo "Install software with: $tool"
''',
    notes={1: 'Write :: printf writes three lines (\\n = new line) into a file named os-release.',
           3: 'Source :: <code>.</code> runs the file in this shell, so each line becomes a variable.',
           5: 'Decide :: <code>[ "$ID_LIKE" = "debian" ]</code> is a test; the family decides the tool.'},
)

WORKED_INTRO = 'Three real tasks: identify the machine you are on, sort a list of servers by family, and find servers whose distribution version is past its end-of-life date.'
EXAMPLES = [
    dict(level='b', tag='Everyday', title='What am I logged in to?',
         problem='<p>Riya has just connected to a new server. In one go she wants its distribution name, its ID, its family and its version.</p>',
         inp='/etc/os-release of the machine',
         approach=['Load <code>/etc/os-release</code> with <code>.</code> inside a subshell.', 'Print the four fields. If ID_LIKE is empty, the distro is a base distro (Debian, Fedora).'],
         code='''(
  . /etc/os-release
  echo "Name   : $PRETTY_NAME"
  echo "ID     : $ID"
  echo "Family : ${ID_LIKE:-$ID (base)}"
  echo "Version: $VERSION_ID"
)
''',
         notes={2: 'Source :: Variables from the file now exist inside this subshell only.', 5: 'Default value :: <code>${ID_LIKE:-…}</code> uses the text after <code>:-</code> when ID_LIKE is empty.'},
         tryit='Run it on OneCompiler: which distribution does it use?'),
    dict(level='i', tag='Operations', title='Group a server list by family',
         problem='<p>The team keeps a simple inventory: one line per server with its name and distribution ID. Print which package tool each server needs.</p>',
         inp='web-01 ubuntu\ndb-01 rhel\netl-01 rocky\nci-01 debian\napi-01 alpine',
         approach=['Write the inventory to a file.', 'Read it line by line with <code>while read name id</code>.', 'Map each ID to a tool with <code>case</code>.'],
         code='''cat > servers.txt <<'EOF'
web-01 ubuntu
db-01 rhel
etl-01 rocky
ci-01 debian
api-01 alpine
EOF
while read -r name id; do
  case $id in
    ubuntu|debian) tool=apt ;;
    rhel|rocky|almalinux|fedora) tool=dnf ;;
    alpine) tool=apk ;;
  esac
  echo "$name ($id) -> $tool"
done < servers.txt
''',
         notes={8: 'Loop :: <code>read</code> takes one line from servers.txt and splits it into name and id.', 14: 'Print :: One line per server. The loop then reads the next line.'},
         tryit='Add “bi-01 almalinux” to the inventory and run again.'),
    dict(level='a', tag='Business problem', title='Which servers are past end of life?',
         problem='<p>An auditor asks: “Which of your servers run a distribution version that no longer receives security updates?” The team has an inventory and a small table of end-of-support dates. Report every server whose date is before today (5 November 2026).</p>',
         inp='inventory: web-01 ubuntu-24.04, old-01 centos-7, rep-01 ubuntu-20.04, db-01 rhel-9\neol dates: centos-7 2024-06-30, ubuntu-20.04 2025-05-31, ubuntu-24.04 2029-05-31, rhel-9 2032-05-31',
         approach=['Store the end-of-support dates in a file and the inventory in another.', 'For each server look up its date with <code>grep</code> and <code>cut</code>.', 'Dates in YYYY-MM-DD form compare correctly as text: <code>[[ $eol < $today ]]</code>.'],
         code='''today=2026-11-05
printf 'centos-7 2024-06-30\\nubuntu-20.04 2025-05-31\\nubuntu-24.04 2029-05-31\\nrhel-9 2032-05-31\\n' > eol.txt
printf 'web-01 ubuntu-24.04\\nold-01 centos-7\\nrep-01 ubuntu-20.04\\ndb-01 rhel-9\\n' > inventory.txt
while read -r server release; do
  eol=$(grep "^$release " eol.txt | cut -d' ' -f2)
  if [[ $eol < $today ]]; then
    echo "UNSUPPORTED: $server runs $release (ended $eol)"
  fi
done < inventory.txt
''',
         notes={5: 'Look up :: grep finds the release’s line; cut takes the second field, the date.', 6: 'Compare :: ISO dates sort like text, so a simple string comparison works.'},
         tryit='Change <code>today</code> to 2030-01-01. Which servers appear now? (End-of-support dates here are for the exercise; always check the vendor’s lifecycle page.)'),
]


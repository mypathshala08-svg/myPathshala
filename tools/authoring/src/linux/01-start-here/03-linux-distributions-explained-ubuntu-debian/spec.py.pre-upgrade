         code="grep '^PRETTY_NAME=' /etc/os-release | cut -d'\"' -f2\n", explain='<code>cut -d\'"\' -f2</code> splits the line at double quotes and keeps the second piece: the text between the quotes.'),
    dict(level='easy', title='Debian family or not?', stmt='Print “Debian family” if <code>/etc/debian_version</code> exists, otherwise “Not Debian family”.', inp='(the machine)',
         code='if [ -f /etc/debian_version ]; then\n  echo "Debian family"\nelse\n  echo "Not Debian family"\nfi\n', explain='<code>-f</code> tests whether a regular file exists. Ubuntu and Debian have this file; RHEL-family systems do not.'),
    dict(level='easy', title='Version from the version string', stmt='Given <code>VERSION_ID="24.04"</code>, print the year and month of release as “Released 20&lt;yy&gt;-&lt;mm&gt;”.', inp='24.04',
         code='v=24.04\necho "Released 20${v%%.*}-${v#*.}"\n', explain='<code>${v%%.*}</code> removes everything from the first dot (24); <code>${v#*.}</code> removes everything up to the dot (04). Shell string tricks are covered in the Shell Scripting course.'),
    dict(level='medium', title='Count servers per tool', stmt='From the inventory, count how many servers need apt and how many need dnf.', inp='web-01 ubuntu\nweb-02 debian\ndb-01 rhel\netl-01 rocky\nci-01 ubuntu',
         code="printf 'web-01 ubuntu\\nweb-02 debian\\ndb-01 rhel\\netl-01 rocky\\nci-01 ubuntu\\n' > inv.txt\necho \"apt: $(grep -cE ' (ubuntu|debian)$' inv.txt)\"\necho \"dnf: $(grep -cE ' (rhel|rocky)$' inv.txt)\"\n",
         explain='<code>grep -cE</code> counts lines matching an extended regex. <code>( a|b )</code> means either word, <code>$</code> the end of the line.'),
    dict(level='medium', title='Base distro or derivative?', stmt='For each sample (ID, ID_LIKE) pair, print “base” if ID_LIKE is empty, otherwise “derivative of …”.', inp='ubuntu:debian\ndebian:\nrocky:rhel',
         code="for pair in ubuntu:debian debian: rocky:rhel; do\n  id=${pair%%:*}; like=${pair#*:}\n  if [ -z \"$like\" ]; then echo \"$id: base\"; else echo \"$id: derivative of $like\"; fi\ndone\n",
         explain='<code>-z</code> is true for an empty string. The pair is split at the colon with the same shell tricks as P3.'),
    dict(level='medium', title='Which package manager is installed?', stmt='Print the first package manager found among apt, dnf, yum, zypper, pacman, apk.', inp='(the machine)',
         code='for pm in apt dnf yum zypper pacman apk; do\n  if command -v "$pm" >/dev/null; then echo "Package manager: $pm"; break; fi\ndone\n',
         explain='<code>command -v</code> succeeds if the command exists; its output is thrown away with <code>>/dev/null</code>. <code>break</code> stops at the first match.'),
    dict(level='business', title='Audit: how many servers are unsupported?', stmt='Using the EOL table and inventory below, print the number of unsupported servers as of 2026-11-05.', inp='eol: centos-7 2024-06-30, ubuntu-20.04 2025-05-31, ubuntu-24.04 2029-05-31\ninventory: a centos-7, b ubuntu-24.04, c ubuntu-20.04, d centos-7',
         code="today=2026-11-05\nprintf 'centos-7 2024-06-30\\nubuntu-20.04 2025-05-31\\nubuntu-24.04 2029-05-31\\n' > eol.txt\nprintf 'a centos-7\\nb ubuntu-24.04\\nc ubuntu-20.04\\nd centos-7\\n' > inv.txt\nn=0\nwhile read -r s r; do\n  e=$(grep \"^$r \" eol.txt | cut -d' ' -f2)\n  [[ $e < $today ]] && n=$((n+1))\ndone < inv.txt\necho \"Unsupported servers: $n\"\n",
         explain='Same lookup as worked example 3, but counting with <code>n=$((n+1))</code>. <code>&amp;&amp;</code> runs the count only when the date test is true.'),
    dict(level='business', title='Docker base image size check', stmt='A team lists base images and their sizes in MB. Print the smallest image and its size.', inp='ubuntu:24.04 78\ndebian:stable-slim 75\nalpine:3.22 8\nrockylinux:9-minimal 92',
         code="printf 'ubuntu:24.04 78\\ndebian:stable-slim 75\\nalpine:3.22 8\\nrockylinux:9-minimal 92\\n' > images.txt\nsort -k2 -n images.txt | head -1\n",
         explain='<code>sort -k2 -n</code> sorts by the second column as numbers; <code>head -1</code> keeps the smallest. (Sizes here are example numbers for the exercise.)'),
]

SCN_INTRO = 'How interviewers check your understanding of distributions in real company situations.'
SCENARIOS = (
    scn('IT services · fresher', 'Fresher', '“Which Linux have you worked on?”',
        'You learnt on Ubuntu. The interviewer says the client project runs RHEL 9. “Can you work on it?”',
        'do you know what transfers and what differs?',
        '''<ul>
          <li>Yes: the kernel, shell, core commands, permissions, processes and systemd work the same.</li>
          <li>Differences I would expect: <code>dnf</code>/<code>rpm</code> instead of <code>apt</code>/<code>dpkg</code>, some package and log names (<code>httpd</code>, <code>/var/log/secure</code>), and SELinux enabled by default.</li>
          <li>I would check <code>/etc/os-release</code> first and read the RHEL documentation for those parts.</li>
        </ul>''', '“Linux is Linux, no difference” or “I only know Ubuntu”.') +
    scn('Startup · design', 'Junior', 'Choosing a distro for production',
        'Your startup is moving its app from a laptop to cloud servers. The CTO asks you to suggest a distribution.',
        'do you choose by support, ecosystem and team skills?',
        '''<ol>
          <li>Prefer a fixed release with long support: Ubuntu LTS, or a RHEL-compatible distro (Rocky Linux / AlmaLinux) if the team or customers prefer the Red Hat family.</li>
          <li>Check that our runtime, database and tools officially support it, and that the cloud offers maintained images.</li>
          <li>Standardise on one distro and version across servers and containers to keep scripts simple.</li>
        </ol>''', 'picking a rolling distro for production, or choosing by what looks nicest on a desktop.') +
    scn('Enterprise · operations', 'Mid-level', 'An end-of-life server',
        'An audit finds five servers still on CentOS 7. Your manager asks what the risk is and what you propose.',
        'do you understand lifecycles and safe migration?',
        '''<ul>
          <li>Risk: CentOS 7 reached end of life on 30 June 2024, so it gets no security patches; any new vulnerability stays open.</li>
          <li>Options: migrate to Rocky Linux or AlmaLinux (same family, least change), RHEL with support, or re-platform on Ubuntu LTS.</li>
          <li>Plan: inventory apps, test on a copy, migrate in small waves with backups and rollback, then add EOL dates to monitoring so it does not happen again.</li>
        </ul>''', '“It still works, so it is fine.”') +
    scn('Product company · containers', 'Mid-level', 'Alpine image breaks the app',
        'The team switched the Docker base image from Debian slim to Alpine to save space. A Python package with compiled parts now fails to install or crashes.',
        'do you know Alpine’s main difference?',
        '''<ul>
          <li>Alpine uses the musl C library instead of glibc; some pre-built binaries (wheels) are made for glibc, so they need compiling or behave differently.</li>
          <li>Options: install build tools and compile, use musl-compatible packages, or go back to a slim glibc image (Debian/Ubuntu slim). A slightly larger image that works is better than a tiny one that breaks.</li>
        </ul>''', 'blaming Docker or Python without checking the base image.')
)

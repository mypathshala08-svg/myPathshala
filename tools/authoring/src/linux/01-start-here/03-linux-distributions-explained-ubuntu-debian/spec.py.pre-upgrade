FAQ = [
    ('What is a Linux distribution?', 'A complete operating system built on the Linux kernel, adding system tools (usually GNU), a package manager and repositories, an installer, default settings and a support lifecycle, maintained by a community or a company.'),
    ('Difference between Debian-based and RHEL-based distributions?', 'Debian-based (Debian, Ubuntu) use .deb packages with apt/dpkg; RHEL-based (RHEL, Rocky, AlmaLinux, Fedora) use .rpm with dnf/rpm. Some paths and names differ (auth.log vs secure, apache2 vs httpd) and RHEL enables SELinux by default while Ubuntu uses AppArmor.'),
    ('What is the difference between Fedora, CentOS Stream and RHEL?', 'Fedora is the fast-moving community distro where new technology appears first. CentOS Stream is the development branch just ahead of the next RHEL minor release. RHEL is the stable, commercially supported product.'),
    ('Why did Rocky Linux and AlmaLinux appear?', 'When CentOS Linux, the popular free RHEL rebuild, was ended in favour of CentOS Stream, these projects were created to continue offering free distributions compatible with RHEL.'),
    ('LTS vs rolling release?', 'An LTS keeps the same package versions for years and only adds security and bug fixes, which suits servers. A rolling release continuously updates to the newest versions, which suits enthusiasts.'),
    ('How do you find which Linux distribution and version a server runs?', '<code>cat /etc/os-release</code> (or <code>lsb_release -a</code> where available). For the kernel version use <code>uname -r</code>.'),
]

PRACTICE_INTRO = 'Small tasks about identifying and grouping distributions. Expected outputs are from real runs on Ubuntu 24.04.'
PROBLEMS = [
